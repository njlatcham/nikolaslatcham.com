		"instructions": [
			{
				"step": 1,
				"para": ["season the chicken with avocado oil and cajun seasoning.", "cook in a pan over medium-high heat to an internal temperature of 68°C (155°F).", "remove from the pan and set aside, keeping the pan for the vegetables."],
				"ingredients": ["chicken", "avocado oil", "cajun seasoning"],
				"title": "season and cook chicken"
			},
			{
				"step": 2,
				"para": ["add the red bell pepper, white onion, garlic, jalapeño, shallot, roasted red pepper, and sun-dried tomatoes to a food processor.", "pulse until roughly diced, not a paste or liquid.", "bring a pot of water to a boil and add salt, then cook the linguine following the package instructions."],
				"ingredients": ["red bell pepper", "white onion", "garlic", "jalapeño", "shallot", "roasted red pepper", "sun-dried tomatoes", "salt", "linguine"],
				"title": "pulse vegetables"
			},
			{
				"step": 3,
				"para": ["add avocado oil to the chicken pan.", "add 3/4 of the vegetable mixture to the pan, and add salt.", "when the vegetables are wilted and fragrant, add the cream, parmesan, and cajun seasoning."],
				"ingredients": ["avocado oil", "salt", "cream", "parmesan", "cajun seasoning"],
				"title": "make sauce"
			},
			{
				"step": 4,
				"para": ["add the pasta to the sauce, saving the pasta water, and add some pasta water to the sauce.", "chop the chicken.", "add the remaining vegetable mixture to another pan with avocado oil, and when fragrant add the chicken and butter."],
				"ingredients": ["linguine", "chicken", "avocado oil", "butter"],
				"title": "add pasta"
			}
